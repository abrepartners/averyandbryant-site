# Site tracking & widgets — all optional; scripts only render when set.
# Add real values in Vercel → Project → Settings → Environment Variables.

# GoHighLevel chat/voice widget ID (Sites → Chat Widget → your widget → copy ID)
NEXT_PUBLIC_GHL_WIDGET_ID=

# Google Tag Manager container (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Meta / Facebook Pixel ID (numeric)
NEXT_PUBLIC_META_PIXEL_ID=
