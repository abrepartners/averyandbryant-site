# Site tracking & widgets — all optional; scripts only render when set.
# Add real values in Vercel → Project → Settings → Environment Variables.

# GoHighLevel chat/voice widget ID (Sites → Chat Widget → your widget → copy ID)
NEXT_PUBLIC_GHL_WIDGET_ID=

# Google Tag Manager container (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Meta / Facebook Pixel ID (numeric)
NEXT_PUBLIC_META_PIXEL_ID=

# ── Aryeo (server-only; never expose to the client) ──
# Bearer token from Aryeo dashboard → Integrations → API
ARYEO_API_KEY=

# Override only if you're pointing at a staging/sandbox Aryeo host
# Defaults to https://api.aryeo.com/v1
ARYEO_API_BASE_URL=

# ── Google Reviews (homepage section is hidden if either is unset) ──
# Server-only API key with Places API (New) enabled
GOOGLE_PLACES_API_KEY=

# Google Place ID for Avery & Bryant (use Place ID Finder to grab it)
GOOGLE_PLACE_ID=

# Public "leave a review" / profile URL shown in the trust bar (optional)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
